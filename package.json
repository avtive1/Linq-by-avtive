{
  "name": "avtive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode dev",
    "build": "next build",
    "build:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode build",
    "start": "next start",
    "start:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode start",
    "lint": "eslint",
    "db:push": "node scripts/prisma-db-push.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:migrate:baseline": "node scripts/prisma-migrate-baseline.mjs",
    "db:generate": "prisma generate",
    "security:reencrypt-attendees": "tsx scripts/reencrypt-attendees.ts",
    "db:indexes": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/apply-indexes.ts",
    "db:audit:indexes": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/audit-indexes.mjs",
    "db:audit:explain": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/explain-queries.mjs",
    "email:outbox:status": "node ./node_modules/tsx/dist/cli.mjs scripts/inspect-email-outbox.ts",
    "email:outbox:process": "node ./node_modules/tsx/dist/cli.mjs scripts/process-email-outbox.ts",
    "load-test:smoke": "node scripts/load-test/smoke-load.mjs",
    "test": "vitest run tests",
    "test:edge": "vitest run tests/edge-cases",
    "test:integration": "vitest run tests/integration",
    "load-test:k6-smoke": "k6 run tests/load/k6-smoke.js",
    "load-test:k6": "k6 run tests/load/k6-load.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@clerk/nextjs": "^7.3.5",
    "@neondatabase/auth": "^0.4.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mon": "^0.0.8",
    "next": "^16.2.11",
    "node": "^26.8.1",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-image-crop": "^11.0.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.18",
    "prisma": "^6.19.3",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
