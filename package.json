{
  "name": "avtive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode dev",
    "build": "next build",
    "build:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode build",
    "start": "next start",
    "start:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/run-shadow.ps1 -Mode start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:migrate:baseline": "node scripts/prisma-migrate-baseline.mjs",
    "db:generate": "prisma generate",
    "security:reencrypt-attendees": "tsx scripts/reencrypt-attendees.ts",
    "db:indexes": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/apply-indexes.ts",
    "db:audit:indexes": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/audit-indexes.mjs",
    "db:audit:explain": "node ./node_modules/tsx/dist/cli.mjs scripts/performance-audit/explain-queries.mjs",
    "load-test:smoke": "node scripts/load-test/smoke-load.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.57.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.44.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-image-crop": "^11.0.10",
    "sonner": "^2.0.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
