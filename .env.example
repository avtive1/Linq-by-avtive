ADMIN_EMAIL=
ADMIN_EMAILS=

# Neon
# Runtime API traffic: use Neon *pooler* URL (hostname contains -pooler).
# Remove channel_binding=require from URLs copied from the Neon console — Node drivers cannot use it.
DATABASE_URL=
# Direct (non-pooled) URL — required for Prisma migrations (`npm run db:migrate` / `db:migrate:deploy`)
DATABASE_URL_DIRECT=

# Database pool / retry tuning (Neon HTTP client + pooler)
# DB_POOL_MAX_RETRIES=3
# DB_POOL_RETRY_BACKOFF_MS=150
# DB_POOL_WARN_DIRECT=false

# Neon Auth
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Sentry (server and browser telemetry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# SMTP (defaults to Gmail SMTP on port 587; request timeouts are enforced)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envelope encryption keys (base64-encoded 32-byte KEK values by key id)
SECURITY_KEKS_JSON={"kek_v1":"<base64-32-byte-key>"}
SECURITY_ACTIVE_KEK_ID=kek_v1

# HMAC key for deterministic lookup tags (base64-encoded >= 32 bytes)
SECURITY_HMAC_KEY=<base64-32-byte-key>

# Attendee token signing keys (Ed25519 PEM keypair by kid)
ATTENDEE_TOKEN_KEYS_JSON=[{"kid":"atk_v1","privateKeyPem":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]
ATTENDEE_TOKEN_ACTIVE_KID=atk_v1

# Optional token settings
ATTENDEE_TOKEN_ISSUER=avtive
ATTENDEE_TOKEN_AUDIENCE=attendee-card
ATTENDEE_TOKEN_TTL_SECONDS=600
# Long-lived share links emailed to guests after registration approval (default 90 days)
# ATTENDEE_SHARE_TOKEN_TTL_SECONDS=7776000

# Optional password pepper (base64 random 32 bytes)
PASSWORD_PEPPER=<base64-32-byte-random>

# Optional: Upstash Redis REST (rate limiting on /api in production). Create a free DB at https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ENABLED=         # set to "false" to disable even when Upstash is configured
# RATE_LIMIT_IN_DEV=true      # enable Upstash limits locally (default off)
# RATELIMIT_GENERAL_PER_MIN=100
# RATELIMIT_AUTH_PER_MIN=5
# RATELIMIT_SENSITIVE_PER_MIN=5
# RATELIMIT_REGISTRATION_PER_MIN=30
# RATELIMIT_UPLOAD_PER_MIN=20
# SHORT_LINK_SLUG_LENGTH=6
