// Prisma schema for versioned SQL migrations.
// The application continues to use @/lib/neon-db (raw SQL); Prisma Client is not required at runtime.
//
// Local schema changes:  npm run db:migrate -- --name <change_name>
// Production deploy:     npm run db:migrate:deploy  (runs in GitHub Actions before Vercel deploy)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                            String    @unique
  organization_name                   String?
  organization_name_key               String?
  role                                String?
  organization_logo_url               String?
  profile_photo_url                   String?
  owner_profile_setup_completed_at    DateTime? @db.Timestamptz(6)
  owner_onboarding_team_step_completed_at DateTime? @db.Timestamptz(6)
  created_at                          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime? @default(now()) @db.Timestamptz(6)

  auth_user                           AuthUser?
  owned_events                        Event[]   @relation("EventOwner")
  owned_organizations                 Organization[] @relation("OrganizationOwner")

  @@index([username], map: "profiles_username_idx")
  @@index([organization_name_key], map: "profiles_organization_name_key_idx")
  @@map("profiles")
}

model AuthUser {
  user_id                 String    @id @db.Uuid
  email                   String    @unique
  email_normalized        String?
  password_hash           String?
  clerk_user_id           String?
  reset_token_hash        String?
  reset_token_expires_at  DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)

  profile                 Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  login_email_otps        LoginEmailOtp[]

  @@index([email], map: "auth_users_email_idx")
  @@index([email_normalized], map: "idx_auth_users_email_norm")
  @@index([reset_token_hash], map: "auth_users_reset_token_hash_idx")
  @@index([clerk_user_id], map: "auth_users_clerk_user_id_uidx")
  @@map("auth_users")
}

model Organization {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_name     String
  organization_name_key String    @unique
  owner_user_id         String?   @db.Uuid
  organization_logo_url String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  owner                 Profile?  @relation("OrganizationOwner", fields: [owner_user_id], references: [id])

  @@index([owner_user_id], map: "organizations_owner_user_id_idx")
  @@index([organization_name_key], map: "organizations_organization_name_key_idx")
  @@map("organizations")
}

model Event {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  name                     String
  description              String    @default("")
  location                 String?
  location_type            String?
  date                     String?
  time                     String?
  logo_url                 String?
  sponsors                 Json?
  registration_form_config Json      @default("{}")
  short_id                 String?   @unique
  card_color               String    @default("purple")
  card_font                String    @default("inter")
  horizontal_text_color    String    @default("")
  vertical_text_color      String    @default("")
  is_branding_finalized    Boolean   @default(false)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)

  owner                    Profile   @relation("EventOwner", fields: [user_id], references: [id])
  attendees                Attendee[]
  access_requests          AccessRequest[]
  access_grants            AccessGrant[]
  registration_requests    RegistrationRequest[]

  @@index([user_id, created_at(sort: Desc)], map: "events_user_id_created_at_idx")
  @@index([short_id], map: "events_short_id_idx")
  @@map("events")
}

model Attendee {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id              String?   @db.Uuid
  user_id               String?   @db.Uuid
  name                  String?
  role                  String?
  company               String?
  event_name            String?
  session_date          String?
  session_time          String?
  location              String?
  track                 String?
  guest_category        String?
  year                  String?
  design_type           String?
  card_color            String?
  card_font             String?
  photo_url             String?
  card_preview_url      String?
  card_email            String?
  linkedin              String?
  card_email_lookup_tag String?
  custom_fields         Json      @default("{}")
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @db.Timestamptz(6)

  event                 Event?    @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id, created_at(sort: Desc)], map: "attendees_event_id_created_at_idx")
  @@index([user_id], map: "attendees_user_id_idx")
  @@map("attendees")
}

model OrganizationMember {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_owner_user_id        String    @db.Uuid
  member_user_id           String?   @db.Uuid
  member_email             String?
  role_label               String
  status                   String
  invite_token_hash        String?
  invite_token_expires_at  DateTime? @db.Timestamptz(6)
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at               DateTime? @db.Timestamptz(6)

  @@unique([org_owner_user_id, member_email], map: "organization_members_owner_email_key")
  @@index([member_user_id, status], map: "organization_members_member_status_idx")
  @@index([member_user_id, org_owner_user_id, status], map: "idx_org_members_permission_lookup")
  @@index([org_owner_user_id, member_user_id, status], map: "organization_members_owner_member_status_idx")
  @@index([org_owner_user_id, created_at(sort: Desc)], map: "organization_members_org_owner_created_at_idx")
  @@index([invite_token_hash], map: "organization_members_invite_token_hash_idx")
  @@index([member_email], map: "organization_members_member_email_idx")
  @@map("organization_members")
}

model OrganizationRolePermissionTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_owner_user_id String   @db.Uuid
  role_label        String
  permissions       String[]
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("organization_role_permission_templates")
}

model OrganizationJoinRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_user_id   String    @db.Uuid
  owner_user_id       String    @db.Uuid
  requested_org_name  String
  status              String
  reapply_after       DateTime? @db.Timestamptz(6)
  rejection_reason    String?
  reviewed_by_user_id String?   @db.Uuid
  reviewed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @db.Timestamptz(6)

  @@index([owner_user_id, status, created_at(sort: Desc)], map: "organization_join_requests_owner_status_created_idx")
  @@index([requester_user_id, created_at(sort: Desc)], map: "organization_join_requests_requester_created_idx")
  @@map("organization_join_requests")
}

model AccessRequest {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id              String?   @db.Uuid
  requester_user_id     String    @db.Uuid
  owner_user_id         String    @db.Uuid
  requested_action      String
  note                  String?
  status                String
  reviewed_by_user_id   String?   @db.Uuid
  reviewed_at           DateTime? @db.Timestamptz(6)
  owner_notified_at     DateTime? @db.Timestamptz(6)
  requester_notified_at DateTime? @db.Timestamptz(6)
  notification_error    String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @db.Timestamptz(6)

  event                 Event?    @relation(fields: [event_id], references: [id])

  @@index([event_id, status, created_at(sort: Desc)], map: "access_requests_event_status_created_idx")
  @@index([owner_user_id, status, created_at(sort: Desc)], map: "access_requests_owner_status_created_idx")
  @@index([requester_user_id, created_at(sort: Desc)], map: "access_requests_requester_created_idx")
  @@map("access_requests")
}

model AccessGrant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id           String?   @db.Uuid
  grantee_user_id    String    @db.Uuid
  granted_by_user_id String    @db.Uuid
  permission         String
  status             String
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @db.Timestamptz(6)

  event              Event?    @relation(fields: [event_id], references: [id])

  @@index([grantee_user_id, status], map: "access_grants_grantee_status_idx")
  @@index([event_id], map: "access_grants_event_id_idx")
  @@index([granted_by_user_id, status], map: "access_grants_granted_by_status_idx")
  @@map("access_grants")
}

model RegistrationRequest {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?   @db.Uuid
  event_id              String    @db.Uuid
  organization_id       String    @db.Uuid
  status                String    @default("PENDING")
  rejection_reason      String?
  attendee_payload      Json      @default("{}")
  card_email_lookup_tag String?
  card_id               String?   @db.Uuid
  reviewed_by_user_id   String?   @db.Uuid
  reviewed_at           DateTime? @db.Timestamptz(6)
  attendee_notified_at  DateTime? @db.Timestamptz(6)
  notification_error    String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  event                 Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status], map: "registration_requests_org_status_idx")
  @@index([event_id, status], map: "registration_requests_event_status_idx")
  @@index([event_id, status, created_at(sort: Desc)], map: "registration_requests_event_status_created_idx")
  @@index([card_id], map: "registration_requests_card_id_idx")
  @@index([user_id], map: "registration_requests_user_id_idx")
  @@map("registration_requests")
}

model ShortLink {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String    @unique
  target_path        String
  created_by_user_id String?   @db.Uuid
  hit_count          BigInt    @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  last_accessed_at   DateTime? @db.Timestamptz(6)

  @@index([target_path], map: "short_links_target_path_idx")
  @@map("short_links")
}

model LoginEmailOtp {
  id          String    @id @db.Uuid
  user_id     String    @db.Uuid
  code_hash   String
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  auth_user   AuthUser  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, expires_at(sort: Desc)], map: "login_email_otp_user_expires_idx")
  @@map("login_email_otp")
}
